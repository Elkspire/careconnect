{
  "name": "careconnect",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "node scripts/dev-local.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:gen-types": "supabase gen types typescript --local --schema public > packages/shared-types/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
