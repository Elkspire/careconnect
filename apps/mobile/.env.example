# Supabase project (same values as apps/web/.env.local — from `supabase status`
# after `supabase start` for local dev, or the hosted project's settings)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NestJS API base URL. localhost/127.0.0.1 only reaches the API from an
# iOS Simulator or the Expo web target on this same machine — a physical
# device (including Expo Go over Wi-Fi) needs this machine's LAN IP
# instead, e.g. http://192.168.1.23:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001
