# Supabase project (local: from `supabase status` after `supabase start`)
# SUPABASE_URL doubles as the JWKS endpoint SupabaseAuthGuard verifies
# tokens against ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) — modern
# Supabase (confirmed: CLI 2.115.0's `supabase start`) signs access tokens
# with ES256 by default, not the legacy HS256 shared secret, so there is no
# JWT secret to configure here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/pooled Postgres connection for Drizzle (service-role level access —
# RLS does not apply here; see supabase/migrations/0001_init.sql's RLS
# strategy notes for why the NestJS guards are the primary enforcement path)
DATABASE_URL=

PORT=3001

# Origin allowed to call this API directly from the browser (CORS) — the
# push-notifications toggle is the only thing that does; everything else
# goes through apps/web's server, which isn't subject to CORS.
WEB_ORIGIN=http://localhost:3000

# Notifications — SMS and WhatsApp are primary channels, not fallbacks (see
# product doc). Both are optional: if unset, sends fail with status
# "not_configured" in notification_log and in-app still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web Push (browser notifications) — generate a pair with
# `npx web-push generate-vapid-keys`. The web app fetches VAPID_PUBLIC_KEY
# from GET /notifications/push/vapid-public-key rather than duplicating it in
# its own env, so this is the only place it's configured.
# VAPID_SUBJECT must be a "mailto:" address or an "https:" URL — the push
# services use it to contact you if your usage looks like abuse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
