{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@careconnect/api",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "staging": false
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}