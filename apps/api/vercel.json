{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@careconnect/api",
  "regions": ["syd1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/internal/cron/no-shows",
      "schedule": "0 16 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "staging": false
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}