# Vercel installs dependencies fresh on its own build machine — never
# upload node_modules (pnpm's store especially balloons this, and
# apps/mobile's native/Hermes binaries blow past Vercel's 100MB
# single-file upload limit).
node_modules

# Both apps/web and apps/api are deployed on Vercel now (as two separate
# projects, each with its own Root Directory), so neither can be excluded
# here — this file applies to the whole repo checkout regardless of which
# project's build is running. Only apps/mobile is unrelated to both.
apps/mobile

# Build/cache output that gets regenerated, not needed as upload input.
apps/web/.next
apps/web/.turbo
apps/api/dist
.turbo
